{
  "Error": "",
  "Topology": [
    {
      "id": "mongo",
      "name": "mongo",
      "kind": "service",
      "variant": "service.run",
      "image": "mongo:7.0",
      "commands": [
        "exec docker-entrypoint.sh mongod '--bind_ip_all' '--port' '27017'"
      ],
      "dependsOn": [],
      "level": 0,
      "sourceSuiteId": "doc",
      "runtimeEnv": {
        "MONGO_INITDB_ROOT_PASSWORD": "secret",
        "MONGO_INITDB_ROOT_USERNAME": "root",
        "MONGO_PORT": "27017"
      }
    },
    {
      "id": "mongo-create-catalog-products",
      "name": "mongo-create-catalog-products",
      "kind": "task",
      "variant": "task.run",
      "image": "mongo:7.0",
      "commands": [
        "for i in $(seq 1 60); do mongosh \"${MONGO_URI:-mongodb://mongo:27017}/catalog\" --username 'root' --password 'secret' --authenticationDatabase admin --quiet --eval 'quit(db.hello().isWritablePrimary ? 0 : 1)' \u003e/dev/null 2\u003e\u00261 \u0026\u0026 break; sleep 1; done",
        "mongosh \"${MONGO_URI:-mongodb://mongo:27017}/catalog\" --username 'root' --password 'secret' --authenticationDatabase admin --eval 'db.createCollection('\\''products'\\'')'"
      ],
      "dependsOn": [
        "mongo"
      ],
      "level": 1,
      "sourceSuiteId": "doc"
    },
    {
      "id": "mongo-idx-products-sku",
      "name": "mongo-idx-products-sku",
      "kind": "task",
      "variant": "task.run",
      "image": "mongo:7.0",
      "commands": [
        "for i in $(seq 1 60); do mongosh \"${MONGO_URI:-mongodb://mongo:27017}/catalog\" --username 'root' --password 'secret' --authenticationDatabase admin --quiet --eval 'quit(db.hello().isWritablePrimary ? 0 : 1)' \u003e/dev/null 2\u003e\u00261 \u0026\u0026 break; sleep 1; done",
        "mongosh \"${MONGO_URI:-mongodb://mongo:27017}/catalog\" --username 'root' --password 'secret' --authenticationDatabase admin --eval 'db.products.createIndex({\"sku\": 1}, {\"unique\": true})'"
      ],
      "dependsOn": [
        "mongo",
        "mongo-create-catalog-products"
      ],
      "level": 2,
      "sourceSuiteId": "doc"
    },
    {
      "id": "mongo-insert-catalog-products",
      "name": "mongo-insert-catalog-products",
      "kind": "task",
      "variant": "task.run",
      "image": "mongo:7.0",
      "commands": [
        "for i in $(seq 1 60); do mongosh \"${MONGO_URI:-mongodb://mongo:27017}/catalog\" --username 'root' --password 'secret' --authenticationDatabase admin --quiet --eval 'quit(db.hello().isWritablePrimary ? 0 : 1)' \u003e/dev/null 2\u003e\u00261 \u0026\u0026 break; sleep 1; done",
        "mongosh \"${MONGO_URI:-mongodb://mongo:27017}/catalog\" --username 'root' --password 'secret' --authenticationDatabase admin --eval 'db.products.insertMany([{\"sku\": \"SKU-001\", \"name\": \"Widget A\", \"price\": 9.99}])'"
      ],
      "dependsOn": [
        "mongo",
        "mongo-idx-products-sku"
      ],
      "level": 3,
      "sourceSuiteId": "doc"
    },
    {
      "id": "app",
      "name": "app",
      "kind": "service",
      "variant": "service.run",
      "image": "catalog-api:latest",
      "dependsOn": [
        "mongo-insert-catalog-products"
      ],
      "level": 4,
      "sourceSuiteId": "doc",
      "runtimeEnv": {
        "MONGO_URI": "mongodb://root:secret@mongo:27017"
      }
    }
  ],
  "Dependencies": null
}
