      "name": "broker-api-ready",
      "kind": "test",
      "variant": "test.run",
      "image": "python:3.12-alpine",
      "commands": [
        "for i in $(seq 1 60); do python -c \"import urllib.request; urllib.request.urlopen('http://broker-api:8080/health')\" 2\u003e/dev/null \u0026\u0026 exit 0; sleep 1; done; echo 'broker-api never answered /health'; exit 1"
