{
  "Error": "",
  "Topology": [
    {
      "id": "pre-hook/session-store",
      "name": "pre-hook/session-store",
      "kind": "service",
      "variant": "service.run",
      "image": "redis:7.2-alpine",
      "commands": [
        "redis-server --save '' --appendonly no"
      ],
      "dependsOn": [],
      "level": 0,
      "sourceSuiteId": "identity-broker",
      "sourceSuiteTitle": "# Identity Broker",
      "sourceRepository": "workspace/identity-broker",
      "sourceVersion": "workspace"
    },
    {
      "id": "pre-hook/upstream-idp",
      "name": "pre-hook/upstream-idp",
      "kind": "service",
      "variant": "service.run",
      "image": "busybox:1.37",
      "commands": [
        "mkdir -p /www/.well-known",
        "echo '{\"issuer\":\"http://upstream-idp:9000\",\"jwks_uri\":\"http://upstream-idp:9000/jwks\"}' \u003e /www/.well-known/openid-configuration",
        "echo '{\"keys\":[]}' \u003e /www/jwks",
        "httpd -f -p 9000 -h /www"
      ],
      "dependsOn": [],
      "level": 0,
      "sourceSuiteId": "identity-broker",
      "sourceSuiteTitle": "# Identity Broker",
      "sourceRepository": "workspace/identity-broker",
      "sourceVersion": "workspace"
    },
    {
      "id": "pre-hook/session-store-alive",
      "name": "pre-hook/session-store-alive",
      "kind": "task",
      "variant": "task.run",
      "image": "redis:7.2-alpine",
      "commands": [
        "attempt=0",
        "until [ \"$(redis-cli -h session-store ping 2\u003e/dev/null)\" = 'PONG' ]; do   attempt=$((attempt+1));   if [ \"$attempt\" -ge 30 ]; then echo 'session store never answered PING' \u003e\u00262; exit 1; fi;   echo \"waiting for session store (attempt $attempt)\";   sleep 1; done",
        "echo 'session store answered PING'",
        "redis-cli -h session-store set babelsuite:gate ok \u003e/dev/null",
        "test \"$(redis-cli -h session-store get babelsuite:gate)\" = 'ok' || (echo 'session store rejected a write' \u003e\u00262; exit 1)",
        "redis-cli -h session-store del babelsuite:gate \u003e/dev/null",
        "echo 'session store accepted a read-write round trip'"
      ],
      "dependsOn": [
        "pre-hook/session-store"
      ],
      "level": 1,
      "sourceSuiteId": "identity-broker",
      "sourceSuiteTitle": "# Identity Broker",
      "sourceRepository": "workspace/identity-broker",
      "sourceVersion": "workspace"
    },
    {
      "id": "pre-hook/upstream-idp-alive",
      "name": "pre-hook/upstream-idp-alive",
      "kind": "task",
      "variant": "task.run",
      "image": "busybox:1.37",
      "commands": [
        "attempt=0",
        "until wget -q -O- http://upstream-idp:9000/.well-known/openid-configuration 2\u003e/dev/null | grep -q 'issuer'; do   attempt=$((attempt+1));   if [ \"$attempt\" -ge 30 ]; then echo 'upstream IdP discovery never became reachable' \u003e\u00262; exit 1; fi;   echo \"waiting for upstream IdP (attempt $attempt)\";   sleep 1; done",
        "echo 'upstream IdP is serving its discovery document'",
        "wget -q -O- http://upstream-idp:9000/jwks | grep -q 'keys' || (echo 'JWKS endpoint is not serving keys' \u003e\u00262; exit 1)",
        "echo 'upstream IdP JWKS endpoint is live'"
      ],
      "dependsOn": [
        "pre-hook/upstream-idp"
      ],
      "level": 1,
      "sourceSuiteId": "identity-broker",
      "sourceSuiteTitle": "# Identity Broker",
      "sourceRepository": "workspace/identity-broker",
      "sourceVersion": "workspace"
    },
    {
      "id": "pre-hook/environment_ready",
      "name": "pre-hook/environment_ready",
      "kind": "log",
      "variant": "log.info",
      "message": "identity environment ready — session store and upstream IdP are both live",
      "dependsOn": [
        "pre-hook/upstream-idp-alive",
