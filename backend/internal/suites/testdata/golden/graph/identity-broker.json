    {
      "id": "login-baseline",
      "name": "login-baseline",
      "kind": "traffic",
      "variant": "traffic.baseline",
      "traffic": {
        "variant": "traffic.baseline",
        "planPath": "traffic/login.star",
        "target": "http://broker-api:8080",
        "users": [
          {
            "id": "probe",
            "name": "begin-login",
            "weight": 1,
            "wait": {
              "mode": "constant",
              "seconds": 0.1
            },
            "tasks": [
              {
                "name": "begin-login",
                "weight": 1,
                "request": {
                  "method": "POST",
                  "path": "/login?provider=oidc",
                  "name": "begin-login",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": "{\"email\":\"load@babelsuite.test\"}"
                }
              }
            ]
          }
        ],
        "stages": [
          {
            "duration": 10000000000,
            "users": 4,
            "spawnRate": 4
          }
        ],
        "thresholds": [
          {
            "metric": "http.error_rate",
            "op": "\u003c=",
            "value": 0.01
          }
        ]
      },
      "dependsOn": [
        "providers_ready"
      ],
      "level": 7,
      "sourceSuiteId": "identity-broker",
      "sourceSuiteTitle": "# Identity Broker",
      "sourceRepository": "workspace/identity-broker",
      "sourceVersion": "workspace"
