    {
      "id": "claims-bridge",
      "name": "claims-bridge",
      "kind": "service",
      "variant": "service.run",
      "image": "python:3.12-alpine",
      "file": "claims_bridge.py",
      "dependsOn": [
        "medical-claims-mock",
        "dental-claims-mock",
        "vision-claims-mock",
        "pharmacy-claims-mock"
      ],
      "level": 1,
      "sourceSuiteId": "soap-claims-hub",
      "sourceSuiteTitle": "# SOAP Claims Hub",
      "sourceRepository": "workspace/soap-claims-hub",
      "sourceVersion": "workspace",
      "runtimeEnv": {
        "CLAIM_TYPES": "medical,dental,vision,pharmacy",
        "PORT": "8080",
        "SOAP_VERSIONS": "1.1,1.2",
        "VALIDATION_LEVEL": "strict"
      }
    },
    {
      "id": "claims-bridge-ready",
      "name": "claims-bridge-ready",
      "kind": "test",
      "variant": "test.run",
      "image": "python:3.12-alpine",
      "commands": [
        "for i in $(seq 1 60); do python -c \"import urllib.request; urllib.request.urlopen('http://claims-bridge:8080/health')\" 2\u003e/dev/null \u0026\u0026 exit 0; sleep 1; done; echo 'claims-bridge never answered /health'; exit 1"
      ],
      "dependsOn": [
        "claims-bridge"
      ],
      "level": 2,
      "sourceSuiteId": "soap-claims-hub",
      "sourceSuiteTitle": "# SOAP Claims Hub",
      "sourceRepository": "workspace/soap-claims-hub",
      "sourceVersion": "workspace"
    },
    {
      "id": "mocks_ready",
      "name": "mocks_ready",
      "kind": "log",
      "variant": "log.info",
      "message": "4 SOAP mocks up; claims-bridge is answering for SOAP 1.1, 1.2",
      "dependsOn": [
        "claims-bridge-ready"
      ],
      "level": 3,
      "sourceSuiteId": "soap-claims-hub",
      "sourceSuiteTitle": "# SOAP Claims Hub",
      "sourceRepository": "workspace/soap-claims-hub",
      "sourceVersion": "workspace"
    },
    {
      "id": "claims-baseline-soap-1_1",
      "name": "claims-baseline-soap-1_1",
      "kind": "traffic",
      "variant": "traffic.baseline",
      "traffic": {
        "variant": "traffic.baseline",
        "planPath": "traffic/claims-1_1.star",
        "target": "http://claims-bridge:8080",
        "users": [
          {
            "id": "probe",
            "name": "submit-claim",
            "weight": 1,
            "wait": {
              "mode": "constant",
              "seconds": 0.1
            },
            "tasks": [
              {
                "name": "submit-claim",
                "weight": 1,
                "request": {
                  "method": "POST",
                  "path": "/claims",
                  "name": "submit-claim",
                  "headers": {
                    "Content-Type": "application/json",
                    "X-Soap-Version": "1.1"
                  },
                  "body": "{\"amount\":4200,\"claimType\":\"medical\",\"lossType\":\"water\",\"policyNumber\":\"MED-1024\"}"
                }
              }
            ]
          }
        ],
        "stages": [
          {
            "duration": 10000000000,
            "users": 4,
            "spawnRate": 4
          }
        ],
        "thresholds": [
          {
            "metric": "http.error_rate",
            "op": "\u003c=",
            "value": 0.01
          }
        ]
      },
      "dependsOn": [
        "mocks_ready"
      ],
      "level": 4,
      "sourceSuiteId": "soap-claims-hub",
      "sourceSuiteTitle": "# SOAP Claims Hub",
      "sourceRepository": "workspace/soap-claims-hub",
      "sourceVersion": "workspace"
    },
