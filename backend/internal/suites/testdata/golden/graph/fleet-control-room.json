    {
      "id": "dispatcher",
      "name": "dispatcher",
      "kind": "service",
      "variant": "service.run",
      "image": "python:3.12-alpine",
      "file": "dispatcher.py",
      "dependsOn": [
        "telemetry-mock",
        "geo-fence-mock"
      ],
      "level": 2,
      "sourceSuiteId": "fleet-control-room",
      "sourceSuiteTitle": "# Fleet Control Room",
      "sourceRepository": "workspace/fleet-control-room",
      "sourceVersion": "workspace",
      "runtimeEnv": {
        "GATEWAY_URL": "http://babelsuite-gateway:9080",
        "GEOFENCE_URL": "http://geo-fence-mock:9080",
        "PORT": "8080",
        "REGIONS": "eu-west",
        "TELEMETRY_URL": "http://telemetry-mock:9080"
      }
    },
    {
      "id": "dispatcher-ready",
      "name": "dispatcher-ready",
      "kind": "test",
      "variant": "test.run",
      "image": "python:3.12-alpine",
      "commands": [
        "for i in $(seq 1 60); do python -c \"import urllib.request; urllib.request.urlopen('http://dispatcher:8080/health')\" 2\u003e/dev/null \u0026\u0026 exit 0; sleep 1; done; echo 'dispatcher never answered /health'; exit 1"
      ],
      "dependsOn": [
        "dispatcher"
      ],
      "level": 3,
      "sourceSuiteId": "fleet-control-room",
      "sourceSuiteTitle": "# Fleet Control Room",
      "sourceRepository": "workspace/fleet-control-room",
      "sourceVersion": "workspace"
    },
    {
      "id": "fleet_ready",
      "name": "fleet_ready",
      "kind": "log",
      "variant": "log.info",
      "message": "1 regions configured; dispatcher is answering",
      "dependsOn": [
        "dispatcher-ready"
      ],
      "level": 4,
      "sourceSuiteId": "fleet-control-room",
      "sourceSuiteTitle": "# Fleet Control Room",
      "sourceRepository": "workspace/fleet-control-room",
      "sourceVersion": "workspace"
    },
    {
      "id": "fleet-ramp",
      "name": "fleet-ramp",
      "kind": "traffic",
      "variant": "traffic.baseline",
      "traffic": {
        "variant": "traffic.baseline",
        "planPath": "traffic/dispatch.star",
        "target": "http://dispatcher:8080",
        "users": [
          {
            "id": "assign",
            "name": "assign-route",
            "weight": 3,
            "wait": {
              "mode": "constant",
              "seconds": 0.1
            },
            "tasks": [
              {
                "name": "assign-route",
                "weight": 1,
                "request": {
                  "method": "POST",
                  "path": "/routes/assign",
                  "name": "assign-route",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": "{\"region\":\"eu-west\",\"routeId\":\"load-1\",\"vehicleId\":\"vh-11\",\"zone\":\"depot-north\"}"
                }
              }
            ]
          },
          {
            "id": "status",
            "name": "read-status",
            "weight": 1,
            "wait": {
              "mode": "constant",
              "seconds": 0.1
            },
            "tasks": [
              {
                "name": "read-status",
                "weight": 1,
                "request": {
                  "method": "GET",
                  "path": "/fleet/status",
                  "name": "read-status"
                }
              }
            ]
          }
        ],
        "stages": [
          {
            "duration": 10000000000,
            "users": 4,
            "spawnRate": 4
          }
        ],
        "thresholds": [
          {
            "metric": "http.error_rate",
            "op": "\u003c=",
            "value": 0.01
          }
        ]
      },
      "dependsOn": [
        "fleet_ready"
      ],
      "level": 5,
      "sourceSuiteId": "fleet-control-room",
      "sourceSuiteTitle": "# Fleet Control Room",
