# Copy to .env at the repo root and fill in real values. .env is gitignored.
#
# One file serves both services:
#   backend  - cmd/server/main.go calls envloader.Load(".env", "../.env"). Started
#              per the README (cd backend && go run ./cmd/server) the CWD is
#              backend/, so backend/.env wins and this root file is the fallback.
#   frontend - vite.config.ts sets envDir: '..', so Vite reads this file and
#              exposes only the VITE_* keys to the browser.

# --- Required ---
JWT_SECRET=                                 # openssl rand -hex 32; rejected if empty or "change-me"

# --- Admin seed; both must be set or no admin account is created ---
ADMIN_EMAIL=admin@babelsuite.test
ADMIN_PASSWORD=admin

# --- Datastore ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=babelsuite

# --- HTTP / CORS ---
PORT=8090
FRONTEND_URL=http://localhost:5173          # CORS allowed origin; empty skips the CORS check
PUBLIC_API_URL=http://localhost:8090        # falls back to VITE_API_URL, then http://localhost:$PORT

# Keep the browser on same-origin relative paths so requests go through the Vite
# proxy and the non-HttpOnly csrf_token cookie is stored and echoed back. An
# absolute URL makes the API cross-origin, and sign-in then fails with a 403
# "CSRF token missing." because the cookie is never retained.
VITE_API_URL=/

# --- Workspace config files (resolved against CWD, then ../) ---
PLATFORM_SETTINGS_FILE=configuration.yaml
PROFILES_FILE=suite-profiles.yaml           # the in-repo file; the built-in default name does not exist
# AGENT_RUNTIME_FILE=babelsuite-agents.yaml # optional; no agents registered if absent

# --- Auth toggles ---
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_SIGNUP_ENABLED=true

# --- Shared secrets for mock/agent callbacks ---
# MOCK_SHARED_SECRET=
# AGENT_SHARED_SECRET=
# TRUSTED_PROXIES=                          # CSV of CIDRs whose X-Forwarded-* headers are trusted

# --- Optional Redis cache ---
# REDIS_ADDR=localhost:6379                 # unset disables Redis entirely
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_PREFIX=babelsuite

# --- Optional cache TTLs (Go durations, e.g. 30s, 2m) ---
# CACHE_TTL_WORKSPACE=
# CACHE_TTL_FAVORITES=
# CACHE_TTL_PROFILES=
# CACHE_TTL_PLATFORM=
# CACHE_TTL_CATALOG=
# CACHE_TTL_EXECUTION_RUNTIME=

# --- Optional HTTP server timeouts (Go durations) ---
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=2m
# HTTP_IDLE_TIMEOUT=2m

# --- Optional observability ---
# LOG_LEVEL=info
# METRICS_ENABLED=false
# METRICS_ADDR=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=babelsuite-backend

# ─── Demo stack (demo/docker-compose.yml) ────────────────────────────────────
# Only read by the compose stack, which must be pointed at this file:
#
#   cd demo && docker compose --env-file ../.env up -d
#
# Ports on the host. Change one when you already have something on it; compose
# fails fast with "port is already allocated" rather than starting half a stack.
# DEMO_MONGO_PORT=27017
# DEMO_REDIS_PORT=6379
# DEMO_ZOT_PORT=5000

# Keep DEMO_ZOT_PORT at 5000 unless you also rewrite the examples: every
# examples/oci-suites/*/metadata.yaml pins its repository as localhost:5000/...,
# and the dependencies.yaml refs do too, so another port leaves the catalog
# pointing at a registry that is not there.

# Image tags. Pinning these is what makes the demo reproducible.
# DEMO_MONGO_TAG=7
# DEMO_REDIS_TAG=7-alpine
# DEMO_ZOT_TAG=latest
# DEMO_PYTHON_TAG=3.12-slim

# Optional telemetry collector: docker compose --profile telemetry up -d
# Gives the runner.run spans and runner.plugin.* attributes somewhere to land;
# point OTEL_EXPORTER_OTLP_ENDPOINT above at http://localhost:4318.
# DEMO_OTEL_TAG=latest
# DEMO_OTLP_GRPC_PORT=4317
# DEMO_OTLP_HTTP_PORT=4318
